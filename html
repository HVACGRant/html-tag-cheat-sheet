const LANGS = [["all", "All"], ["html", "HTML"], ["css", "CSS"], ["js", "JS"]];
const LANG_LABEL = { html: "HTML", css: "CSS", js: "JS" };
let activeLang = "all";
const inLang = t => activeLang === "all" || t.lang === activeLang;
const catsFor = () => ["All"].concat(Array.from(new Set(TAGS.filter(inLang).map(t => t.cat))));
const $ = id => document.getElementById(id);
const grid = $("grid"), qEl = $("q"), countEl = $("count"), emptyEl = $("empty");
let activeCat = "All";

const esc = s => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
const escRe = s => s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");

function hilite(text, terms, isTag) {
  if (!terms.length) return esc(text);
  const re = new RegExp((isTag ? "" : "(?<![A-Za-z0-9])") + "(" + terms.map(escRe).join("|") + ")", "gi");
  return text.split(re).map((part, i) => i % 2 ? '<mark class="hit">' + esc(part) + "</mark>" : esc(part)).join("");
}

function parseTerms(raw) {
  return raw.toLowerCase().replace(/[<>\/]/g, " ").split(/\s+/).filter(Boolean);
}

function matches(t, terms, bracketed) {
  if (!terms.length) return true;
  if (bracketed) return t.lang === "html" && [t.tag].concat(t.alias || []).some(n => n.indexOf(terms[0]) === 0);   // "<em>" searches tag names only
  const rest = (t.def + " " + t.cat + " " + (t.look || "") + " " + (t.note || "") + " " + (t.kw || "")).toLowerCase();
  return terms.every(term => t.tag.toLowerCase().indexOf(term) !== -1 || new RegExp("(?<![a-z0-9])" + escRe(term)).test(rest));
}

function score(t, terms) {
  if (!terms.length) return 0;
  let s = 0;
  terms.forEach(term => {
    const name = t.tag.toLowerCase();
    if (name === term) s += 100;
    else if (name.indexOf(term) === 0) s += 50;
    else if (name.indexOf(term) !== -1) s += 20;
  });
  return -s;
}

const kidsHtml = n => Array.from({ length: n }, (_, i) => '<span class="k">' + (i + 1) + "</span>").join("");
function demoHtml(t) {
  if (t.lang === "js") return "";
  if (t.nr) return '<div class="nrnote">' + (t.nr === true ? "Not visible on the page, so no live preview. Code only." : esc(t.nr)) + "</div>";
  let d = t.demo;
  if (!d && t.lang === "css") d = t.kids ? '<div style="' + esc(t.ex) + '">' + kidsHtml(t.kids) + "</div>"
                                          : '<div class="sample" style="' + esc(t.ex) + '">Sample text</div>';
  if (!d) d = t.ex;
  return '<div class="demo">' + d + "</div>";
}

function cardHtml(t, terms) {
  const src = t.ex;
  return '<article class="card' + (t.obsolete ? " obsolete" : "") + '">' +
    '<div class="head"><span class="tag">' + (t.lang === "html" ? "&lt;" + hilite(t.tag, terms, true) + "&gt;" : hilite(t.tag, terms, true)) + '</span>' +
    '<span class="cat"><span class="lang">' + LANG_LABEL[t.lang] + "</span> &middot; " + esc(t.cat) + "</span>" +
    (t.obsolete ? '<span class="badge">Obsolete</span>' : "") + "</div>" +
    '<p class="def">' + hilite(t.def, terms) + "</p>" +
    (t.look ? '<div class="look"><b>Default look:</b> ' + hilite(t.look, terms) + "</div>" : "") +
    (t.note ? '<p class="note">' + hilite(t.note, terms) + "</p>" : "") +
    demoHtml(t) +
    '<div class="codebox"><pre class="src">' + esc(src) + '</pre><button class="copy" type="button" data-copy="' + esc(src) + '">Copy</button></div>' +
    "</article>";
}

function render() {
  const terms = parseTerms(qEl.value);
  const bracketed = /[<>]/.test(qEl.value);
  const list = TAGS.filter(t => inLang(t) && (activeCat === "All" || t.cat === activeCat) && matches(t, terms, bracketed))
                   .sort((a, b) => score(a, terms) - score(b, terms));
  grid.innerHTML = list.map(t => cardHtml(t, terms)).join("");
  countEl.textContent = list.length + " of " + TAGS.filter(inLang).length + " entries";
  emptyEl.style.display = list.length ? "none" : "block";
  $("searchrow").classList.toggle("has-text", qEl.value.length > 0);
}

function buildChips() {
  $("chips").innerHTML = catsFor().map(c =>
    '<button type="button" class="chip" data-cat="' + esc(c) + '" aria-pressed="' + (c === activeCat) + '">' + esc(c) + "</button>").join("");
}

function buildTabs() {
  $("tabs").innerHTML = LANGS.map(([id, label]) => {
    const n = id === "all" ? TAGS.length : TAGS.filter(t => t.lang === id).length;
    return '<button type="button" class="tab" role="tab" data-lang="' + id + '" aria-selected="' + (id === activeLang) + '">' + label + "<small>" + n + "</small></button>";
  }).join("");
}
$("tabs").addEventListener("click", e => {
  const b = e.target.closest(".tab");
  if (!b) return;
  activeLang = b.dataset.lang;
  activeCat = "All";
  buildTabs(); buildChips(); render();
});

$("chips").addEventListener("click", e => {
  const b = e.target.closest(".chip");
  if (!b) return;
  activeCat = b.dataset.cat;
  buildChips();
  render();
});

grid.addEventListener("click", e => {
  const b = e.target.closest(".copy");
  if (!b) return;
  const text = b.dataset.copy;
  const done = () => { b.textContent = "Copied"; setTimeout(() => b.textContent = "Copy", 1200); };
  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(text).then(done, () => fallbackCopy(text, done));
  } else fallbackCopy(text, done);
});

function fallbackCopy(text, done) {
  const ta = document.createElement("textarea");
  ta.value = text; ta.style.position = "fixed"; ta.style.opacity = "0";
  document.body.appendChild(ta); ta.select();
  try { document.execCommand("copy"); done(); } catch (err) {}
  document.body.removeChild(ta);
}

grid.addEventListener("click", e => { if (e.target.closest(".demo a, .demo area")) e.preventDefault(); });
grid.addEventListener("submit", e => e.preventDefault());
qEl.addEventListener("input", render);
$("clear").addEventListener("click", () => { qEl.value = ""; render(); qEl.focus(); });

document.addEventListener("keydown", e => {
  const ae = document.activeElement, typing = ae && (/^(INPUT|TEXTAREA|SELECT)$/.test(ae.tagName) || ae.isContentEditable);
  if (e.key === "/" && !typing) { e.preventDefault(); qEl.focus(); qEl.select(); }
  else if (e.key === "Escape") { qEl.value = ""; render(); qEl.blur(); }
});

buildTabs();
buildChips();
render();
qEl.focus();
</script>
</body>
</html>
