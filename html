<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Web Dev Cheat Sheet</title>
<style>
  :root {
    color-scheme: light dark;
    --bg: #f6f7f9;
    --card: #ffffff;
    --ink: #1b1f27;
    --muted: #5d6675;
    --line: #dfe3ea;
    --accent: #c2410c;
    --accent-soft: #ffedd5;
    --code-bg: #f0f2f6;
    --hit: #fde68a;
    --warn: #b91c1c;
    --warn-soft: #fee2e2;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #12151b;
      --card: #1b2029;
      --ink: #e7eaf0;
      --muted: #97a1b3;
      --line: #2c3340;
      --accent: #fb923c;
      --accent-soft: #3a2413;
      --code-bg: #10131a;
      --hit: #6b5a12;
      --warn: #fca5a5;
      --warn-soft: #3b1717;
    }
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font: 16px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }
  .wrap { max-width: 980px; margin: 0 auto; padding: 0 16px 64px; }

  header.top {
    position: sticky; top: 0; z-index: 10;
    background: var(--bg);
    padding: 16px 0 12px;
    border-bottom: 1px solid var(--line);
  }
  h1 { font-size: 1.25rem; margin: 0 0 10px; letter-spacing: .01em; }
  h1 span { color: var(--accent); font-family: ui-monospace, Menlo, Consolas, monospace; }

  .searchrow { position: relative; }
  #q {
    width: 100%;
    font: inherit;
    padding: 12px 84px 12px 14px;
    border: 2px solid var(--line);
    border-radius: 10px;
    background: var(--card);
    color: var(--ink);
    outline: none;
  }
  #q:focus { border-color: var(--accent); }
  .hint {
    position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
    font-size: .78rem; color: var(--muted);
    pointer-events: none;
  }
  #clear {
    position: absolute; right: 8px; top: 50%; transform: translateY(-50%);
    display: none;
    border: 0; background: var(--code-bg); color: var(--ink);
    border-radius: 6px; padding: 4px 10px; font: inherit; font-size: .85rem; cursor: pointer;
  }
  .searchrow.has-text #clear { display: block; }
  .searchrow.has-text .hint { display: none; }

  .tabs { display: flex; gap: 0; margin-top: 10px; border: 1px solid var(--line); border-radius: 10px; overflow: hidden; width: fit-content; max-width: 100%; }
  .tab {
    border: 0; border-right: 1px solid var(--line); background: var(--card); color: var(--ink);
    padding: 6px 16px; font: inherit; font-size: .9rem; font-weight: 600; cursor: pointer;
  }
  .tab:last-child { border-right: 0; }
  .tab small { font-weight: 400; color: var(--muted); margin-left: 4px; }
  .tab[aria-selected="true"] { background: var(--accent); color: #fff; }
  .tab[aria-selected="true"] small { color: #fff; opacity: .85; }
  .chips { display: flex; gap: 6px; margin-top: 10px; overflow-x: auto; padding-bottom: 4px; scrollbar-width: thin; }
  .chip {
    border: 1px solid var(--line);
    background: var(--card);
    color: var(--ink);
    padding: 4px 12px;
    border-radius: 999px;
    font: inherit; font-size: .85rem;
    cursor: pointer; flex: none;
  }
  .chip[aria-pressed="true"] { background: var(--accent); border-color: var(--accent); color: #fff; }
  .count { margin: 12px 0 4px; font-size: .85rem; color: var(--muted); }

  .grid { display: grid; gap: 12px; margin-top: 8px; }
  @media (min-width: 720px) { .grid { grid-template-columns: 1fr 1fr; } }

  .card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 14px 16px;
    display: flex; flex-direction: column; gap: 8px;
    min-width: 0;
  }
  .card.obsolete { border-color: var(--warn); }
  .head { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .tag {
    font: 700 1.15rem ui-monospace, Menlo, Consolas, monospace;
    color: var(--accent);
  }
  .cat {
    font-size: .72rem; text-transform: uppercase; letter-spacing: .06em;
    color: var(--muted);
  }
  .badge {
    font-size: .7rem; font-weight: 700; text-transform: uppercase;
    background: var(--warn-soft); color: var(--warn);
    border-radius: 4px; padding: 1px 6px;
  }
  .def { margin: 0; }
  .note { margin: 0; font-size: .88rem; color: var(--muted); }
  .look { font-size: .82rem; color: var(--muted); }
  .look b { font-weight: 600; color: var(--ink); }

  .demo {
    border: 1px dashed var(--line);
    border-radius: 8px;
    padding: 8px 10px;
    overflow-wrap: anywhere;
  }
  .demo > * { margin: 0; }
  .demo table { border-collapse: collapse; }
  .demo th, .demo td { border: 1px solid var(--line); padding: 2px 8px; }
  .demo img, .demo svg, .demo canvas, .demo iframe { max-width: 100%; }
  .sample { padding: 6px 10px; background: var(--accent-soft); border: 1px solid var(--accent); border-radius: 6px; }
  .k { display: inline-block; min-width: 36px; padding: 4px 10px; text-align: center; background: var(--accent-soft); border: 1px solid var(--accent); border-radius: 4px; }
  .d-hover:hover { background: var(--accent); color: #fff; transform: translateY(-4px); }
  @keyframes d-pulse { 0%, 100% { opacity: 1; } 50% { opacity: .3; } }
  @media (prefers-reduced-motion: reduce) { .demo * { animation: none !important; transition: none !important; } }
  .lang { font-weight: 700; color: var(--ink); }
  .nrnote { font-size: .82rem; color: var(--muted); font-style: italic; }
  .codebox { position: relative; }
  pre.src {
    margin: 0;
    background: var(--code-bg);
    border-radius: 8px;
    padding: 10px 64px 10px 10px;
    font: .82rem/1.45 ui-monospace, Menlo, Consolas, monospace;
    white-space: pre-wrap; overflow-wrap: anywhere;
  }
  .copy {
    position: absolute; top: 6px; right: 6px;
    border: 1px solid var(--line); background: var(--card); color: var(--ink);
    border-radius: 6px; padding: 2px 8px; font: inherit; font-size: .75rem; cursor: pointer;
  }

  mark.hit { background: var(--hit); color: inherit; border-radius: 2px; }
  .empty { text-align: center; color: var(--muted); padding: 48px 0; display: none; }
  footer { margin-top: 32px; font-size: .8rem; color: var(--muted); text-align: center; }
</style>
</head>
<body>
<div class="wrap">
  <header class="top">
    <h1>Web dev <span>&lt;/&gt;</span> cheat sheet</h1>
    <div class="searchrow" id="searchrow">
      <input id="q" type="search" autocomplete="off" spellcheck="false"
             placeholder="Search anything: table, flex, fetch, bold, center..." aria-label="Search tags">
      <span class="hint">press /</span>
      <button id="clear" type="button">Clear</button>
    </div>
    <div class="tabs" id="tabs" role="tablist" aria-label="Language"></div>
    <div class="chips" id="chips" role="group" aria-label="Filter by category"></div>
  </header>

  <div class="count" id="count" aria-live="polite"></div>
  <main class="grid" id="grid"></main>
  <div class="empty" id="empty">Nothing matches that search.</div>
  <footer>Tip: press <b>/</b> to jump to search, <b>Esc</b> to clear it.</footer>
</div>

<script>
// ---- DATA: add or edit tags here. Fields: tag, cat, def, ex (HTML shown/copied), demo (optional HTML rendered instead of ex),
// look, note, kw (extra search words), alias (extra names for <tag> search), nr (true = do not render a live preview), obsolete
const IMG = "data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20width=%2260%22%20height=%2240%22%3E%3Crect%20width=%2260%22%20height=%2240%22%20rx=%224%22%20fill=%22%23c2410c%22/%3E%3C/svg%3E";
const TAGS = [
  // ===== Document =====
  { tag: "html", cat: "Document", def: "The root element. Everything else lives inside it. Set the page language here with lang.",
    look: "None", ex: `<html lang="en">\n  <head>...</head>\n  <body>...</body>\n</html>`, kw: "root lang document", nr: true },
  { tag: "head", cat: "Document", def: "Container for page metadata: title, meta, links, styles. Not shown on the page.",
    look: "Hidden", ex: `<head>\n  <meta charset="utf-8">\n  <title>My page</title>\n</head>`, kw: "metadata header invisible", nr: true },
  { tag: "body", cat: "Document", def: "The visible content of the page.",
    look: "Block, 8px margin", ex: `<body>\n  <h1>Hello</h1>\n</body>`, kw: "content page visible", nr: true },

  // ===== Metadata =====
  { tag: "title", cat: "Metadata", def: "The page title shown in the browser tab, bookmarks, and search results.",
    look: "Hidden", ex: `<title>My Page</title>`, kw: "tab name bookmark seo", nr: true },
  { tag: "meta", cat: "Metadata", def: "Metadata about the page: character set, viewport, description. Void element.",
    look: "Hidden", note: "The viewport line is what makes a page work properly on phones.",
    ex: `<meta charset="utf-8">\n<meta name="viewport" content="width=device-width, initial-scale=1">\n<meta name="description" content="Short summary">`, kw: "charset viewport description seo mobile void", nr: true },
  { tag: "link", cat: "Metadata", def: "Links an external resource to the page, usually a stylesheet or icon. Void element.",
    look: "Hidden", ex: `<link rel="stylesheet" href="style.css">\n<link rel="icon" href="favicon.ico">`, kw: "stylesheet css icon favicon void", nr: true },
  { tag: "base", cat: "Metadata", def: "Sets the base URL that all relative links on the page resolve against. Void element.",
    look: "Hidden", ex: `<base href="https://example.com/">`, kw: "url relative void", nr: true },
  { tag: "style", cat: "Metadata", def: "Embedded CSS for the page.",
    look: "Hidden", ex: `<style>\n  p { color: tomato; }\n</style>`, kw: "css stylesheet embedded", nr: true },

  // ===== Sections =====
  { tag: "header", cat: "Sections", def: "Intro content or navigation for the page or a section: logo, title, nav.",
    look: "Block", ex: `<header>\n  <h1>Site name</h1>\n</header>`, kw: "top banner intro" },
  { tag: "nav", cat: "Sections", def: "A block of major navigation links.",
    look: "Block", ex: `<nav>\n  <a href="#">Home</a> | <a href="#">About</a>\n</nav>`, kw: "navigation menu links" },
  { tag: "main", cat: "Sections", def: "The dominant content of the page. Only one visible main per page.",
    look: "Block", ex: `<main>\n  <p>The page's main content.</p>\n</main>`, kw: "primary content landmark" },
  { tag: "section", cat: "Sections", def: "A thematic group of content, usually with its own heading.",
    look: "Block", ex: `<section>\n  <h2>Tips</h2>\n  <p>Content...</p>\n</section>`, kw: "group thematic chapter" },
  { tag: "article", cat: "Sections", def: "Self-contained content that makes sense on its own: a post, news story, or comment.",
    look: "Block", ex: `<article>\n  <h2>Blog post</h2>\n  <p>Text...</p>\n</article>`, kw: "post blog story comment" },
  { tag: "aside", cat: "Sections", def: "Content tangential to the main content: sidebar, pull quote, callout.",
    look: "Block", ex: `<aside>\n  <p>Related: see also...</p>\n</aside>`, kw: "sidebar callout tangent" },
  { tag: "footer", cat: "Sections", def: "Footer for the page or a section: copyright, links, author info.",
    look: "Block", ex: `<footer>\n  <p>&copy; 2026 My Site</p>\n</footer>`, kw: "bottom copyright" },
  { tag: "hgroup", cat: "Sections", def: "Groups a heading with its subtitle or tagline.",
    look: "Block", ex: `<hgroup>\n  <h2>Main title</h2>\n  <p>The subtitle</p>\n</hgroup>`, kw: "heading group subtitle tagline" },
  { tag: "search", cat: "Sections", def: "Container for a search or filtering interface. Newer element.",
    look: "Block", ex: `<search>\n  <input type="search" placeholder="Find...">\n</search>`, kw: "find filter landmark" },
  { tag: "h1-h6", alias: ["h1", "h2", "h3", "h4", "h5", "h6"], cat: "Sections", def: "Headings, from most important (h1) to least (h6). Don't skip levels.",
    look: "Bold, sized by level", ex: `<h1>Main title</h1>\n<h2>Section</h2>\n<h3>Subsection</h3>`, kw: "h1 h2 h3 h4 h5 h6 heading title header level" },

  // ===== Grouping =====
  { tag: "p", cat: "Grouping", def: "A paragraph of text.",
    look: "Block with vertical margin", ex: `<p>A paragraph of text.</p>`, kw: "paragraph text" },
  { tag: "div", cat: "Grouping", def: "Generic block container with no meaning. Use it for layout and styling hooks.",
    look: "Block", ex: `<div class="box">Grouped content</div>`, demo: `<div style="padding:6px;background:rgba(194,65,12,.15)">Grouped content</div>`, kw: "division container block generic layout" },
  { tag: "hr", cat: "Grouping", def: "A thematic break between paragraphs. Void element.",
    look: "Horizontal line", ex: `<p>Above</p>\n<hr>\n<p>Below</p>`, kw: "horizontal rule line divider void" },
  { tag: "figure", cat: "Grouping", def: "Self-contained content like an image, diagram, or code block, with an optional caption.",
    look: "Indented block", ex: `<figure>\n  <img src="pic.jpg" alt="Condenser unit">\n  <figcaption>Fig 1. Condenser</figcaption>\n</figure>`,
    demo: `<figure style="margin:0"><img src="${IMG}" alt="Condenser unit"><figcaption>Fig 1. Condenser</figcaption></figure>`, kw: "image caption diagram" },
  { tag: "figcaption", cat: "Grouping", def: "The caption for a figure.",
    look: "Block", ex: `<figure>\n  <pre>x = 1</pre>\n  <figcaption>Example</figcaption>\n</figure>`, kw: "caption figure" },

  // ===== Lists =====
  { tag: "ul", cat: "Lists", def: "Unordered (bulleted) list.",
    look: "Bullets, indented", ex: `<ul>\n  <li>Coil</li>\n  <li>Fan</li>\n</ul>`, kw: "unordered bullets list" },
  { tag: "ol", cat: "Lists", def: "Ordered (numbered) list. Attributes: start, reversed, type.",
    look: "Numbers, indented", ex: `<ol start="3">\n  <li>Third</li>\n  <li>Fourth</li>\n</ol>`, kw: "ordered numbered list start reversed" },
  { tag: "li", cat: "Lists", def: "A list item inside ul, ol, or menu.",
    look: "List item", ex: `<ul>\n  <li>Item</li>\n</ul>`, kw: "item bullet" },
  { tag: "dl", cat: "Lists", def: "Description list: terms paired with their descriptions.",
    look: "Block", ex: `<dl>\n  <dt>Superheat</dt>\n  <dd>Temperature above saturation</dd>\n</dl>`, kw: "description definition glossary terms" },
  { tag: "dt", cat: "Lists", def: "A term (name) in a description list.",
    look: "Block", ex: `<dl>\n  <dt>Subcooling</dt>\n  <dd>Temperature below saturation</dd>\n</dl>`, kw: "term name description" },
  { tag: "dd", cat: "Lists", def: "The description or value for a term in a description list.",
    look: "Indented block", ex: `<dl>\n  <dt>Ton</dt>\n  <dd>12,000 BTU/hr</dd>\n</dl>`, kw: "description value definition" },
  { tag: "menu", cat: "Lists", def: "Toolbar-style list of commands. Behaves like ul.",
    look: "Bullets, indented", ex: `<menu>\n  <li><button type="button">Copy</button></li>\n  <li><button type="button">Paste</button></li>\n</menu>`, kw: "toolbar commands list" },

  // ===== Links =====
  { tag: "a", cat: "Links", def: "Anchor: a hyperlink. href is the destination.",
    look: "Blue, underlined", note: "Use href=\"#id\" to jump to a section on the page and the download attribute to save a file.",
    ex: `<a href="https://example.com" target="_blank" rel="noopener">Visit site</a>`, kw: "link hyperlink href anchor url target download" },

  // ===== Tables =====
  { tag: "table", cat: "Tables", def: "Tabular data arranged in rows and columns.",
    look: "Block", ex: `<table>\n  <tr><th>Unit</th><th>Tons</th></tr>\n  <tr><td>A</td><td>3</td></tr>\n</table>`, kw: "grid rows columns data" },
  { tag: "caption", cat: "Tables", def: "The title or caption of a table.",
    look: "Centered above table", ex: `<table>\n  <caption>Units</caption>\n  <tr><td>A</td><td>3</td></tr>\n</table>`, kw: "table title" },
  { tag: "thead", cat: "Tables", def: "Groups the header rows of a table.",
    look: "Row group", ex: `<table>\n  <thead><tr><th>Unit</th></tr></thead>\n  <tbody><tr><td>A</td></tr></tbody>\n</table>`, kw: "table header group" },
  { tag: "tbody", cat: "Tables", def: "Groups the body rows of a table.",
    look: "Row group", ex: `<table>\n  <thead><tr><th>Unit</th></tr></thead>\n  <tbody><tr><td>A</td></tr></tbody>\n</table>`, kw: "table body group" },
  { tag: "tfoot", cat: "Tables", def: "Groups the footer rows of a table, like totals.",
    look: "Row group", ex: `<table>\n  <tbody><tr><td>3</td></tr><tr><td>4</td></tr></tbody>\n  <tfoot><tr><td>Total: 7</td></tr></tfoot>\n</table>`, kw: "table footer totals" },
  { tag: "tr", cat: "Tables", def: "A row in a table.",
    look: "Table row", ex: `<table>\n  <tr><td>Cell 1</td><td>Cell 2</td></tr>\n</table>`, kw: "table row" },
  { tag: "th", cat: "Tables", def: "A header cell. Use scope=\"col\" or scope=\"row\" to say what it heads.",
    look: "Bold, centered", ex: `<table>\n  <tr><th scope="col">Name</th><th scope="col">Qty</th></tr>\n</table>`, kw: "table header cell scope" },
  { tag: "td", cat: "Tables", def: "A data cell. colspan and rowspan merge cells.",
    look: "Table cell", ex: `<table>\n  <tr><td colspan="2">Merged cell</td></tr>\n  <tr><td>A</td><td>B</td></tr>\n</table>`, kw: "table cell data colspan rowspan merge" },
  { tag: "colgroup", cat: "Tables", def: "Groups columns in a table so you can style them together.",
    look: "Hidden", ex: `<table>\n  <colgroup>\n    <col style="background:#fde68a">\n    <col>\n  </colgroup>\n  <tr><td>A</td><td>B</td></tr>\n</table>`, kw: "table columns group" },
  { tag: "col", cat: "Tables", def: "One column (or span of columns) inside a colgroup. Void element.",
    look: "Hidden", ex: `<table>\n  <colgroup><col span="2" style="background:#fde68a"></colgroup>\n  <tr><td>A</td><td>B</td><td>C</td></tr>\n</table>`, kw: "table column span void" },

  // ===== Forms =====
  { tag: "form", cat: "Forms", def: "Wraps form controls. action is where it submits, method is GET or POST.",
    look: "Block", ex: `<form action="/send" method="post">\n  <input name="email" placeholder="Email">\n  <button>Send</button>\n</form>`, kw: "submit post get action input" },
  { tag: "label", cat: "Forms", def: "Caption for a form control. Clicking it focuses the control.",
    look: "Inline", ex: `<label for="demo-name">Name</label>\n<input id="demo-name">`, kw: "caption input for" },
  { tag: "input", cat: "Forms", def: "A form control. The type attribute picks the kind. Void element.",
    look: "Depends on type", note: "Types: text, email, password, number, checkbox, radio, range, date, color, file, search, tel, url, hidden, submit.",
    ex: `<input type="text" placeholder="Type here">\n<input type="checkbox"> <input type="range">`, kw: "text email password number checkbox radio range date color file field void" },
  { tag: "button", cat: "Forms", def: "A clickable button. type is submit, reset, or button.",
    look: "Button", ex: `<button type="button">Click me</button>`, kw: "click submit reset" },
  { tag: "select", cat: "Forms", def: "A dropdown list of options.",
    look: "Dropdown", ex: `<select>\n  <option>Cool</option>\n  <option>Heat</option>\n</select>`, kw: "dropdown menu choose" },
  { tag: "option", cat: "Forms", def: "One choice inside a select, optgroup, or datalist.",
    look: "Menu item", ex: `<select>\n  <option value="c">Cool</option>\n  <option value="h" selected>Heat</option>\n</select>`, kw: "choice select value" },
  { tag: "optgroup", cat: "Forms", def: "Groups related options inside a select under a label.",
    look: "Bold group label", ex: `<select>\n  <optgroup label="Modes">\n    <option>Cool</option>\n    <option>Heat</option>\n  </optgroup>\n</select>`, kw: "group select options" },
  { tag: "datalist", cat: "Forms", def: "Suggested values for an input. Link it with the input's list attribute.",
    look: "Hidden", ex: `<input list="demo-list">\n<datalist id="demo-list">\n  <option value="R-410A">\n  <option value="R-22">\n</datalist>`, kw: "autocomplete suggestions" },
  { tag: "textarea", cat: "Forms", def: "Multi-line text input. Size it with rows and cols.",
    look: "Multi-line box", ex: `<textarea rows="3" cols="24">Notes...</textarea>`, kw: "multiline text box notes" },
  { tag: "fieldset", cat: "Forms", def: "Groups related form controls, drawn with a border.",
    look: "Bordered box", ex: `<fieldset>\n  <legend>Mode</legend>\n  <label><input type="radio" name="m"> Cool</label>\n  <label><input type="radio" name="m"> Heat</label>\n</fieldset>`, kw: "group controls border" },
  { tag: "legend", cat: "Forms", def: "The caption for a fieldset.",
    look: "Title on the border", ex: `<fieldset>\n  <legend>Options</legend>\n  <label><input type="checkbox"> Enable</label>\n</fieldset>`, kw: "fieldset caption title" },
  { tag: "output", cat: "Forms", def: "Displays the result of a calculation or user action.",
    look: "Inline", ex: `<output>42</output>`, kw: "result calculation" },
  { tag: "progress", cat: "Forms", def: "A progress bar showing how far along a task is.",
    look: "Progress bar", ex: `<progress value="70" max="100">70%</progress>`, kw: "bar loading percent" },
  { tag: "meter", cat: "Forms", def: "A gauge for a value within a known range, like disk usage.",
    look: "Gauge bar", ex: `<meter value="0.6">60%</meter>`, kw: "gauge range level" },

  // ===== Media =====
  { tag: "img", cat: "Media", def: "An image. alt text is required for accessibility. Void element.",
    look: "Inline image", ex: `<img src="photo.jpg" alt="Condenser unit" width="60">`,
    demo: `<img src="${IMG}" alt="Condenser unit" width="60">`, kw: "image picture photo alt src void" },
  { tag: "picture", cat: "Media", def: "Lets the browser choose between image versions by screen size or format.",
    look: "Inline image", ex: `<picture>\n  <source srcset="wide.webp" media="(min-width:800px)">\n  <img src="small.jpg" alt="Condenser unit">\n</picture>`,
    demo: `<picture><img src="${IMG}" alt="Condenser unit" width="60"></picture>`, kw: "responsive image webp srcset" },
  { tag: "source", cat: "Media", def: "An alternate resource for picture, audio, or video. Void element.",
    look: "Hidden", ex: `<video controls>\n  <source src="clip.webm" type="video/webm">\n  <source src="clip.mp4" type="video/mp4">\n</video>`, kw: "media alternate format void", nr: true },
